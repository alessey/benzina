{
  "name": "benzina",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w @benzina/client",
    "test": "vitest run",
    "typecheck": "tsc -p packages/shared && tsc -p packages/server && tsc -p packages/client",
    "dev:client": "npm run dev -w @benzina/client",
    "dev:server": "npm run dev -w @benzina/server",
    "bots": "npm run bots -w @benzina/server --"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
